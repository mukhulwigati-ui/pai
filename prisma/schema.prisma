generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id              Int     @id @default(autoincrement())
  identity_number String  @unique
  password        String
  fullname        String
  birth_date      String?
  education       String?
  address         String?
  role            String  @default("TEACHER")
  status          String  @default("Aktif")

  assignments Assignment[]
  halaqahs Halaqah[]
}

model Subject {
  id    Int    @id @default(autoincrement())
  name  String
  level String @default("SMP")

  assignments Assignment[]
  cps         CP[]

  @@unique([name, level])
  @@index([level])
}

model CP {
  id          Int    @id @default(autoincrement())
  code        String
  description String
  subjectId   Int
  grade       Int    @default(7)
  semester    Int    @default(1)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tps     TP[]
  halaqahs Halaqah[]

  @@index([subjectId])
  @@index([grade])
  @@index([semester])
  @@index([subjectId, grade, semester])
}

model TP {
  id          Int    @id @default(autoincrement())
  code        String
  description String
  cpId        Int

  cp          CP           @relation(fields: [cpId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([cpId])
}

model Student {
  id         Int     @id @default(autoincrement())
  nisn       String  @unique
  fullname   String
  birth_info String?
  gender     String
  class_name String
  address    String?
  status     String  @default("Aktif")

  assessments  Assessment[]
  attendances  Attendance[]
  homeroomNote HomeroomNote?
  personality  Personality?
  tahfidzs     Tahfidz[]
  promotions   StudentPromotion[]
  halaqahMembers HalaqahMember[]

  @@index([class_name])
  @@index([status])
}

model Assessment {
  id        Int    @id @default(autoincrement())
  studentId Int
  tpId      Int?
  score     Int
  type      String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tp      TP?     @relation(fields: [tpId], references: [id], onDelete: Cascade)

  @@unique([studentId, tpId, type])
  @@index([studentId])
  @@index([tpId])
  @@index([type])
}

model Tahfidz {
  id        Int      @id @default(autoincrement())
  studentId Int
  juz       Int
  surah     String
  ayat      String
  predicate String
  date      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  className String
  day       String
  status    String
  date      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([className])
  @@index([date])
  @@index([day])
  @@index([status])
}

model ClassRoom {
  id     Int    @id @default(autoincrement())
  name   String @unique
  level  String
  grade  Int
  status String @default("Aktif")

  @@index([level])
  @@index([grade])
  @@index([status])
}

model Assignment {
  id           Int    @id @default(autoincrement())
  teacherId    Int
  subjectId    Int
  className    String
  academicYear String @default("2026/2027")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, className, academicYear])
  @@index([teacherId])
  @@index([subjectId])
  @@index([className])
  @@index([academicYear])
}

model Personality {
  id         Int    @id @default(autoincrement())
  studentId  Int    @unique
  className  String
  suluk      String @default("-")
  muwadhotah String @default("-")
  nadzofah   String @default("-")
  indhiplat  String @default("-")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([className])
  @@index([studentId])
}

model HomeroomNote {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique
  className String
  note      String   @default("")
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([className])
  @@index([studentId])
}

model SystemSetting {
  id            Int      @id @default(autoincrement())
  schoolName    String   @default("Pondok Pesantren Terpadu Ulul Albab")
  academicYear  String   @default("2026/2027")
  semester      String   @default("Ganjil")
  principalName String   @default("Pimpinan Pesantren")
  updatedAt     DateTime @updatedAt
}

model StudentPromotion {
  id           Int      @id @default(autoincrement())
  studentId    Int
  academicYear String
  fromClass    String
  toClass      String
  status       String   @default("NAIK")
  note         String?
  promotedAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYear])
  @@index([studentId])
  @@index([academicYear])
  @@index([fromClass])
  @@index([toClass])
  @@index([status])
}

// Keanggotaan dipisahkan dari kelas sekolah. Riwayat disimpan saat pindah kelompok.
model Halaqah {
  id Int @id @default(autoincrement())
  name String
  jilid Int
  academicYear String
  semester Int
  teacherId Int?
  active Boolean @default(true)
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  cps CP[]
  members HalaqahMember[]
  @@unique([name, academicYear, semester])
}

model HalaqahMember {
  id Int @id @default(autoincrement())
  halaqahId Int
  studentId Int
  joinedAt DateTime @default(now())
  leftAt DateTime?
  halaqah Halaqah @relation(fields: [halaqahId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  @@index([studentId, leftAt])
  @@index([halaqahId, leftAt])
}
